---
import type { CollectionEntry } from 'astro:content';

const { projects, level = 3 } = Astro.props as { projects: CollectionEntry<'projects'>[]; level?: 2 | 3 };
const H = `h${level}` as 'h2' | 'h3';
---

<div class="cards">
  {
    projects.map((p) => (
      <a class="card" href={`/projects/${p.id}`}>
        <div class="card-top">
          <H class="card-title">{p.data.title}</H>
          <span class="card-arrow" aria-hidden="true">↗</span>
        </div>
        <p>{p.data.description}</p>
        <ul class="tags" aria-label="Tech">
          {p.data.tags.map((t) => <li>{t}</li>)}
        </ul>
      </a>
    ))
  }
</div>

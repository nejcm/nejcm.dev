---
import Card from './Card.astro';

const { href, title, description, kind = 'link' } = Astro.props as { href: string; title: string; description?: string; kind?: 'docs' | 'demo' | 'link' };
const paths = {
  docs: 'M4 2h6l4 4v8H4zM10 2v4h4M6.5 9h5M6.5 11.5h5',
  demo: 'M2 3h12v9H2zM5.5 14.5h5M7 5.5v4l3-2z',
  link: 'M7 9a3 3 0 004.2 0l2-2a3 3 0 00-4.2-4.2l-.7.7M9 7a3 3 0 00-4.2 0l-2 2a3 3 0 004.2 4.2l.7-.7',
};
---

<Card href={href} title={title} description={description}>
  <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"><path d={paths[kind]} /></svg>
</Card>

---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getProjects } from '../../lib';

export async function getStaticPaths() {
  return (await getProjects()).map((p) => ({ params: { slug: p.id }, props: { p } }));
}

const { p } = Astro.props as { p: CollectionEntry<'projects'> };
const { Content } = await render(p);
const links = [
  p.data.repo && { label: 'GitHub', href: p.data.repo },
  p.data.docs && { label: 'Docs', href: p.data.docs },
  p.data.example && { label: 'Example', href: p.data.example },
  p.data.url && { label: 'App', href: p.data.url },
].filter(Boolean) as { label: string; href: string }[];
---

<Base title={p.data.title} description={p.data.description}>
  <article class="panel">
    <header class="panel-head pad">
      <p class="kicker"><a class="navlink" href="/projects">← Projects</a></p>
      <h1 class="page-title">{p.data.title}</h1>
      <p class="lede">{p.data.description}</p>
      <ul class="tags" aria-label="Tech">{p.data.tags.map((t) => <li>{t}</li>)}</ul>
      {
        links.length > 0 && (
          <div class="links">
            {links.map((l) => (
              <a href={l.href} rel="noopener">
                {l.label} <span aria-hidden="true">↗</span>
                <span class="sr-only">(opens external site)</span>
              </a>
            ))}
          </div>
        )
      }
    </header>
    <div class="prose"><Content /></div>
  </article>
</Base>
